<Window x:Class="Calculator.Mortgage.MortgageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.Mortgage"
        xmlns:lib="clr-namespace:ControlLibrary;assembly=ControlLibrary"
        mc:Ignorable="d"
        Title="Mortgage Calculator" Height="600" MaxWidth="800"
        Background="#F7F9FB"
        SizeToContent="Height"
        FontFamily="Segoe UI" FontSize="16">

    <Window.DataContext>
        <local:MortgageViewModel/>
    </Window.DataContext>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Mortgage Calculator" FontSize="28" FontWeight="Bold" Foreground="#2D4159" Margin="0 0 0 18"/>
        <Border Grid.Row="1" CornerRadius="12" Background="White" Padding="24" BorderBrush="#D1D9E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Input fields (left / center) -->
                <lib:FieldControl Grid.Row="0" Grid.Column="0" Label="Total Cost" Value="{Binding Path=Mortgage.TotalCost, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat=C2 }"  ToolTip="Enter the total cost of the property."/>
                <lib:FieldControl Grid.Row="1" Grid.Column="0"  Label="Down Payment (%)" Value="{Binding Path=Mortgage.DownPaymentPercent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:#.0#}%}"  ToolTip="Enter the down payment as a percentage."/>
                <lib:FieldControl Grid.Row="2" Grid.Column="0"  Label="Down Payment (Value)" Value="{Binding Path=Mortgage.DownPayment, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat=C2}"  ToolTip="Down payment in currency value."/>
                <lib:FieldControl Grid.Row="3" Grid.Column="0" Label="Rate (%)" Value="{Binding Path=Mortgage.AnnualInterestRate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:#.0#}%}" ToolTip="Annual interest rate."/>
                <lib:FieldControl Grid.Row="4" Grid.Column="0" Label="Amortization (Years)" Value="{Binding Path=Mortgage.Ammortization, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:#.0#}}" ToolTip="Number of years to pay off the mortgage."/>

                <!-- Payment number slider -->
                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Vertical" Margin="0,8,0,0">
                    <TextBlock Text="Payment Number" FontSize="14" FontWeight="SemiBold" Foreground="#2D4159" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Orientation="Horizontal" Name="ParentPanel">
                            <Slider Width="200" Minimum="1" Maximum="{Binding MaxPaymentNumber}" Value="{Binding PaymentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="12" SmallChange="1"/>
                        </StackPanel>
                        <TextBox Text="{Binding PaymentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="SemiBold" Foreground="#2D4159" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="/" FontSize="14" FontWeight="SemiBold" Foreground="#2D4159" Margin="6,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MaxPaymentNumber}" FontSize="14" Foreground="#33475B" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Calculated values panel (right column). Easily extend by adding more label/value pairs inside the StackPanel or turn this into an ItemsControl bound to a VM collection. -->
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="6" Background="#F4F7FB" Padding="12" CornerRadius="8" BorderBrush="#E3E9F2" BorderThickness="1" Margin="12 0 0 0">
                    <StackPanel>
                        <TextBlock Text="Calculated Values" FontWeight="SemiBold" Foreground="#2D4159" Margin="0 0 0 12"/>

                        <lib:FieldControl IsReadOnly="True" Label="Monthly Payment" Value="{Binding Path=Mortgage.MonthlyPayment, StringFormat=C2}"/>
                        <lib:FieldControl IsReadOnly="True" Label="Initial Principal" Value="{Binding Path=Mortgage.InitialPrincipal, StringFormat=C2}"/>
                        <lib:FieldControl IsReadOnly="True" Label="Remaining Principal" Value="{Binding Path=RemainingPrincipal, StringFormat=C2}"/>
                        <lib:FieldControl IsReadOnly="True" Label="Total Interest Paid" Value="{Binding Path=TotalInterestPaid, StringFormat=C2}"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Row="2" Margin="0 18 0 0">
            <Button Name="CloseBtn" FontSize="18" FontWeight="Bold" Click="CloseBtn_Click" Height="44" Width="120" Background="#2D4159" Foreground="White" BorderBrush="#2D4159" Cursor="Hand"  Margin="0 0 0 0" >Close</Button>
        </StackPanel>
    </Grid>
</Window>

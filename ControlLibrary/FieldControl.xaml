<UserControl x:Class="ControlLibrary.FieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlLibrary"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid" Margin="5,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label FontSize="15" FontWeight="DemiBold" Padding="0,1" Grid.Column="0" x:Name="FieldLabel" HorizontalContentAlignment="Left" Content="{Binding Path=Label, FallbackValue=Label}" VerticalContentAlignment="Bottom"/>
        <TextBox Grid.Row="1"  x:Name="FieldTextBox" FontSize="15" Text="{Binding Path=Value, FallbackValue=Value}" MinWidth="10" VerticalAlignment="Center"/>
    </Grid>
</UserControl>

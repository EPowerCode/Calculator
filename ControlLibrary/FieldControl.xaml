<UserControl x:Class="ControlLibrary.FieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlLibrary"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid" Margin="5,2">
        <!-- Editable layout: label above textbox -->
        <StackPanel Orientation="Vertical" x:Name="EditablePanel">
            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="#2D4159" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, FallbackValue=$100}" HorizontalContentAlignment="Right" FontSize="15" Padding="6,2" MinWidth="120" BorderBrush="#D1D9E6" BorderThickness="1" />
        </StackPanel>

        <!-- Read-only layout: label and value in a 2-column grid for alignment using SharedSizeGroup -->
        <Grid x:Name="ReadOnlyGrid" VerticalAlignment="Center" Visibility="Collapsed" IsSharedSizeScope="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ValueGroup"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="#2D4159" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="15" FontWeight="Bold" Foreground="#2D4159" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
